# vim: ft=ghostty

# Colors
theme = UbuntuDark
background-opacity = 0.85

# Keybinds
keybind = shift+space=text:\x1b[32;2u
keybind = ctrl+0=text:\x1b[48;5u
keybind = ctrl+1=text:\x1b[49;5u
keybind = ctrl+2=text:\x1b[50;5u
keybind = ctrl+3=text:\x1b[51;5u
keybind = ctrl+4=text:\x1b[52;5u
keybind = ctrl+5=text:\x1b[53;5u
keybind = ctrl+6=text:\x1b[54;5u
keybind = ctrl+7=text:\x1b[55;5u
keybind = ctrl+8=text:\x1b[56;5u
keybind = ctrl+9=text:\x1b[57;5u
# Free alt+digit (default: goto_tab) for nvim
keybind = alt+1=unbind
keybind = alt+digit_1=unbind
keybind = alt+2=unbind
keybind = alt+digit_2=unbind
keybind = alt+3=unbind
keybind = alt+digit_3=unbind
keybind = alt+4=unbind
keybind = alt+digit_4=unbind
keybind = alt+5=unbind
keybind = alt+digit_5=unbind
keybind = alt+6=unbind
keybind = alt+digit_6=unbind
keybind = alt+7=unbind
keybind = alt+digit_7=unbind
keybind = alt+8=unbind
keybind = alt+digit_8=unbind
keybind = alt+9=unbind
keybind = alt+digit_9=unbind

# Font
font-feature = -calt
